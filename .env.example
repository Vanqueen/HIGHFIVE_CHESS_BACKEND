# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Frontend HTTP/HTTPS origins allowed by the API and Socket.IO.
# Replace localhost with the exact public frontend origin(s) in production.
CLIENT_ORIGINS=http://localhost:5173

# Exact number of trusted reverse proxies in front of Express.
# Keep at zero if the API is directly exposed or the network path is unknown.
TRUST_PROXY_HOPS=0

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
